# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/cult"

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Google OAuth (Client ID is public; Secret stays server-side only)
GOOGLE_CLIENT_ID=350724521850-hih32056okk7bv7kt58imn9jmeobng4k.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CULT <no-reply@example.com>"

# Frontend
FRONTEND_URL=http://localhost:5173

# Payments (Razorpay) - used by future modules
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps (Mapbox) - used by future modules
MAPBOX_ACCESS_TOKEN=

# Weather (OpenWeatherMap) - used by future modules
OPENWEATHER_API_KEY=